{
  "info": {
    "name": "Star Wars Blog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Create users, planets and characters in Flask Admin first. Update IDs below. X-User-ID selects a user for the exercise and does not authenticate the caller."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "people_id",
      "value": "1"
    },
    {
      "key": "planet_id",
      "value": "1"
    },
    {
      "key": "vehicle_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List people",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-ID",
            "value": "{{user_id}}"
          }
        ],
        "url": "{{base_url}}/people"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get person",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-ID",
            "value": "{{user_id}}"
          }
        ],
        "url": "{{base_url}}/people/{{people_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
